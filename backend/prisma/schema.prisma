// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

enum Gender {
  M
  F
}

model Superstar {
  id       Int      @id @default(autoincrement())
  name     String
  overall  Int
  gender   Gender
}

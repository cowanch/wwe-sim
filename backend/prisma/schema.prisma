// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

enum Gender {
  M
  F
}

enum Brand {
  RAW
  SMACKDOWN
  NXT
}

enum Division {
  MAIN_EVENT
  MID_CARD
  WOMENS
  TAG_TEAM
}

enum Phase {
  EXHIBITION
  CONTENDER
  PPV
  TOURNAMENT
}

enum MatchType {
  SINGLE
  TAG_TEAM
  BATTLE_ROYAL
  ROYAL_RUMBLE
  ELIMINATION_CHAMBER
  ELIMINATION_TAG_TEAM
  HELL_IN_A_CELL
  STELL_CAGE
  EXTREME_RULES
  LADDER
  MONEY_IN_THE_BANK_LADDER
  TABLES_LADDERS_CHAIRS
  TABLE
}

enum WeekOfMonth {
  FIRST
  SECOND
  THIRD
  FOURTH
  LAST
}

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model Superstar {
  id            Int        @id @default(autoincrement())
  name          String
  overall       Int
  gender        Gender
  tagTeam       TagTeamMembership?
  brandHistory  BrandMembership[]
  matchSides    MatchSide[]
  tournaments   TournamentSeed[]
}

model TagTeam {
  id            Int          @id @default(autoincrement())
  name          String
  members       TagTeamMembership[]
  brandHistory  BrandMembership[]
  matchSides    MatchSide[]
  tournaments   TournamentSeed[]
}

model TagTeamMembership {
  superstarId   Int        @unique
  superstar     Superstar  @relation(fields: [superstarId], references: [id])
  tagTeamId     Int
  tagTeam       TagTeam    @relation(fields: [tagTeamId], references: [id])
  order         Int
  @@id([superstarId, tagTeamId])
}

model Title {
  id              Int       @id @default(autoincrement())
  name            String
  isChampionship  Boolean
  brand           Brand?
  division        Division?
  matches         Match[]
  matchSides      MatchSide[]
  tournaments     Tournament[]
}

model Match {
  id            Int        @id @default(autoincrement())
  phase         Phase
  cycleId       Int
  cycle         PpvCycle  @relation(fields: [cycleId], references: [id])
  matchType     MatchType
  sides         MatchSide[]
  brandSwapIn   BrandMembership?  @relation("StartMatch")
  brandSwapOut  BrandMembership?  @relation("EndMatch")
  tournament    TournamentMatch?
  titleId       Int?
  title         Title? @relation(fields: [titleId], references: [id])
}

model MatchSide {
  id            Int         @id @default(autoincrement())
  matchId       Int
  match         Match       @relation(fields: [matchId], references: [id])
  superstars    Superstar[]
  tagTeamId     Int?
  tagTeam       TagTeam?    @relation(fields: [tagTeamId], references: [id])
  winner        Boolean
  titleId       Int?
  title         Title? @relation(fields: [titleId], references: [id])
  @@unique([id, matchId])
}

model BrandMembership {
  id            Int         @id @default(autoincrement())
  superstarId   Int?
  superstar     Superstar?  @relation(fields: [superstarId], references: [id])
  tagTeamId     Int?
  tagTeam       TagTeam?    @relation(fields: [tagTeamId], references: [id])
  brand         Brand
  division      Division
  startMatchId  Int         @unique
  startMatch    Match       @relation("StartMatch", fields: [startMatchId], references: [id])
  endMatchId    Int?        @unique
  endMatch      Match?      @relation("EndMatch", fields: [endMatchId], references: [id])
}

model Tournament {
  id       Int         @id @default(autoincrement())
  name     String
  titleId  Int
  title    Title @relation(fields: [titleId], references: [id])
  matches  TournamentMatch[]
  seeds    TournamentSeed[]
}

model TournamentMatch {
  id            Int         @id @default(autoincrement())
  tournamentId  Int
  tournament    Tournament  @relation(fields: [tournamentId], references: [id])
  matchId       Int         @unique
  match         Match       @relation(fields: [matchId], references: [id])
  matchNumber   Int
}

model TournamentSeed {
  tournamentId  Int
  tournament    Tournament  @relation(fields: [tournamentId], references: [id])
  superstarId   Int?
  superstar     Superstar?  @relation(fields: [superstarId], references: [id])
  tagTeamId     Int?
  tagTeam       TagTeam?    @relation(fields: [tagTeamId], references: [id])
  seedNumber    Int
  @@id([tournamentId, seedNumber])
}

model Ppv {
  id      Int     @id @default(autoincrement())
  name    String
  month   Int
  week    WeekOfMonth
  day     Weekday
  brands  Brand[]
  cycles  PpvCycle[]
}

model PpvCycle {
  id      Int   @id @default(autoincrement())
  year    Int
  ppvs    Ppv[]
  matches Match[]
  brands  Brand[]
}

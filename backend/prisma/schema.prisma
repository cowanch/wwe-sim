// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

enum Gender {
  M
  F
}

enum Brand {
  RAW
  SMACKDOWN
  NXT
}

enum Division {
  MAIN_EVENT
  MID_CARD
  WOMENS
  TAG_TEAM
}

enum Phase {
  EXHIBITION
  CONTENDER
  PPV
  TOURNAMENT
}

enum WeekOfMonth {
  FIRST
  SECOND
  THIRD
  FOURTH
  LAST
}

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model Superstar {
  id            Int        @id @default(autoincrement())
  name          String
  overall       Int
  gender        Gender
  tagTeam       TagTeamMembership?
  brandHistory  BrandMembership[]
  matchSides    MatchSide[]
  tournaments   TournamentSeed[]
}

model TagTeam {
  id            Int          @id @default(autoincrement())
  name          String
  members       TagTeamMembership[]
  brandHistory  BrandMembership[]
  matchSides    MatchSide[]
  tournaments   TournamentSeed[]
}

model TagTeamMembership {
  superstarId   Int        @unique
  superstar     Superstar  @relation(fields: [superstarId], references: [id])
  tagTeamId     Int
  tagTeam       TagTeam    @relation(fields: [tagTeamId], references: [id])
  order         Int
  @@id([superstarId, tagTeamId])
}

model Title {
  id              Int       @id @default(autoincrement())
  name            String
  isChampionship  Boolean
  brand           Brand?
  division        Division?
  matches         MatchTitle[]
  matchSides      MatchSideTitle[]
  tournaments     Tournament[]
}

// Single, Tag Team, Battle Royal, Elimination Chamber, Royal Rumble, Money in the Bank, Ladder, TLC
model MatchType {
  id       Int        @id @default(autoincrement())
  name     String
  matches  Match[]
}

model Match {
  id            Int        @id @default(autoincrement())
  phase         Phase
  cycleId       Int
  cycle         PpvCycle  @relation(fields: [cycleId], references: [id])
  matchTypeId   Int
  matchType     MatchType  @relation(fields: [matchTypeId], references: [id])
  sides         MatchSide[]
  brandSwapIn   BrandMembership?  @relation("StartMatch")
  brandSwapOut  BrandMembership?  @relation("EndMatch")
  tournament    TournamentMatch?
  title         MatchTitle?
}

model MatchSide {
  id            Int         @id @default(autoincrement())
  matchId       Int
  match         Match       @relation(fields: [matchId], references: [id])
  superstars    Superstar[]
  tagTeamId     Int?
  tagTeam       TagTeam?    @relation(fields: [tagTeamId], references: [id])
  winner        Boolean
  title         MatchSideTitle?
  @@unique([id, matchId])
}

// If a match has a title, it is being defended
model MatchTitle {
  matchId         Int            @unique
  match           Match          @relation(fields: [matchId], references: [id])
  titleId         Int
  title    Title @relation(fields: [titleId], references: [id])
  @@id([matchId, titleId])
}

model MatchSideTitle {
  matchSideId     Int          @unique
  matchSide       MatchSide    @relation(fields: [matchSideId], references: [id])
  titleId  Int
  title    Title @relation(fields: [titleId], references: [id])
  @@id([matchSideId, titleId])
}

model BrandMembership {
  id            Int         @id @default(autoincrement())
  superstarId   Int?
  superstar     Superstar?  @relation(fields: [superstarId], references: [id])
  tagTeamId     Int?
  tagTeam       TagTeam?    @relation(fields: [tagTeamId], references: [id])
  brand         Brand
  division      Division
  startMatchId  Int         @unique
  startMatch    Match       @relation("StartMatch", fields: [startMatchId], references: [id])
  endMatchId    Int?        @unique
  endMatch      Match?      @relation("EndMatch", fields: [endMatchId], references: [id])
}

model Tournament {
  id       Int         @id @default(autoincrement())
  name     String
  titleId  Int
  title    Title @relation(fields: [titleId], references: [id])
  matches  TournamentMatch[]
  seeds    TournamentSeed[]
}

model TournamentMatch {
  id            Int         @id @default(autoincrement())
  tournamentId  Int
  tournament    Tournament  @relation(fields: [tournamentId], references: [id])
  matchId       Int         @unique
  match         Match       @relation(fields: [matchId], references: [id])
  matchNumber   Int
}

model TournamentSeed {
  tournamentId  Int
  tournament    Tournament  @relation(fields: [tournamentId], references: [id])
  superstarId   Int?
  superstar     Superstar?  @relation(fields: [superstarId], references: [id])
  tagTeamId     Int?
  tagTeam       TagTeam?    @relation(fields: [tagTeamId], references: [id])
  seedNumber    Int
  @@id([tournamentId, seedNumber])
}

model Ppv {
  id      Int     @id @default(autoincrement())
  name    String
  month   Int
  week    WeekOfMonth
  day     Weekday
  brands  Brand[]
  cycles  PpvCycle[]
}

model PpvCycle {
  id      Int   @id @default(autoincrement())
  ppvId   Int
  ppv     Ppv @relation(fields: [ppvId], references: [id])
  year    Int
  matches Match[]
  brands  Brand[]
}
